{
  "name": "pi-pstack",
  "version": "0.1.0",
  "description": "pstack, ported to pi: skills loaded through dynamic resources, subagents for pi-subagents, and a hand-authored pi harness adapter",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "test": "node --test harness-core.test.ts questions-core.test.ts questions-tui.test.ts"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pstack",
    "poteto-mode",
    "unslop"
  ],
  "pi": {
    "extensions": ["./index.ts"],
    "skills": ["./skills"],
    "subagents": {
      "agents": ["./agents"]
    }
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-tui": "1.4.0",
    "typebox": "^1.4.3"
  }
}
